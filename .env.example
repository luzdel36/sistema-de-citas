# Copia este archivo a .env.local (o .env) y llena los valores reales.
# Ninguno de los dos se sube a GitHub (ya están en .gitignore).

# De developers.facebook.com > tu app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cualquier texto que tú inventes; lo repites al conectar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=

# De console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
